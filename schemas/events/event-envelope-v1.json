{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://continuity.local/schemas/events/event-envelope-v1.json",
  "title": "Continuity Event Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope_version",
    "event_id",
    "project_id",
    "workspace_id",
    "event_type",
    "payload_schema",
    "producer",
    "privacy_class",
    "payload"
  ],
  "properties": {
    "envelope_version": { "const": "1.0" },
    "event_id": { "$ref": "../common/definitions-v1.json#/$defs/uuidv7" },
    "project_id": { "$ref": "../common/definitions-v1.json#/$defs/uuidv7" },
    "workspace_id": { "$ref": "../common/definitions-v1.json#/$defs/uuidv7" },
    "session_id": {
      "oneOf": [
        { "$ref": "../common/definitions-v1.json#/$defs/uuidv7" },
        { "type": "null" }
      ]
    },
    "event_type": {
      "enum": [
        "session.started", "session.ended", "session.crashed",
        "turn.started", "turn.ended",
        "model.requested", "model.responded", "model.failed",
        "tool.started", "tool.completed", "tool.failed",
        "command.started", "command.completed",
        "file.observed", "file.written", "file.deleted",
        "git.head.changed", "git.status.observed", "git.diff.captured", "git.commit.created",
        "decision.recorded", "checkpoint.created",
        "context.assembled", "context.injected",
        "capsule.created", "capsule.verified", "capsule.recovered",
        "capture.redacted", "capture.dropped", "proxy.route.selected",
        "task.created", "task.transitioned", "task.session_linked", "workspace.registered",
        "claim.superseded"
      ]
    },
    "payload_schema": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._]+@[1-9][0-9]*$"
    },
    "occurred_at": {
      "oneOf": [
        { "$ref": "../common/definitions-v1.json#/$defs/rfc3339Utc" },
        { "type": "null" }
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sequence"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "correlation_id": {
      "oneOf": [
        { "$ref": "../common/definitions-v1.json#/$defs/uuidv7" },
        { "type": "null" }
      ]
    },
    "causation_id": {
      "oneOf": [
        { "$ref": "../common/definitions-v1.json#/$defs/uuidv7" },
        { "type": "null" }
      ]
    },
    "privacy_class": { "enum": ["public", "internal", "private", "secret"] },
    "payload": { "type": "object" }
  }
}
