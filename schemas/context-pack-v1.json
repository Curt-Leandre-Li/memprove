{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://continuity.local/schemas/context-pack-v1.json",
  "title": "Continuity Context Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "context_pack_id", "project_id", "workspace_id",
    "objective", "token_budget", "token_count", "freshness_policy",
    "renderer", "renderer_version", "token_estimator_version",
    "project_event_seq", "snapshot_digest", "items", "omissions",
    "assembly_trace", "manifest_digest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "context_pack_id": { "$ref": "common/definitions-v1.json#/$defs/sha256" },
    "project_id": { "$ref": "common/definitions-v1.json#/$defs/uuidv7" },
    "workspace_id": { "$ref": "common/definitions-v1.json#/$defs/uuidv7" },
    "task_id": {
      "oneOf": [
        { "$ref": "common/definitions-v1.json#/$defs/uuidv7" },
        { "type": "null" }
      ]
    },
    "objective": { "type": "string", "minLength": 1 },
    "token_budget": { "type": "integer", "minimum": 1 },
    "token_count": { "type": "integer", "minimum": 0 },
    "freshness_policy": { "enum": ["current_only", "include_stale_marked"] },
    "renderer": { "enum": ["codex", "claude", "cursor", "markdown", "json"] },
    "renderer_version": { "type": "string", "minLength": 1 },
    "token_estimator_version": { "type": "string", "minLength": 1 },
    "project_event_seq": { "type": "integer", "minimum": 0 },
    "snapshot_digest": { "$ref": "common/definitions-v1.json#/$defs/sha256" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_type", "source_id", "revision_id", "priority_class", "token_count", "content", "evidence_refs"],
        "properties": {
          "source_type": { "enum": ["task", "conflict", "decision", "fact", "evidence", "plan", "observation", "hypothesis"] },
          "source_id": { "$ref": "common/definitions-v1.json#/$defs/uuidv7" },
          "revision_id": {
            "oneOf": [
              { "$ref": "common/definitions-v1.json#/$defs/uuidv7" },
              { "type": "null" }
            ]
          },
          "priority_class": { "type": "integer", "minimum": 1, "maximum": 5 },
          "token_count": { "type": "integer", "minimum": 0 },
          "content": { "type": "string" },
          "evidence_refs": {
            "type": "array",
            "items": { "$ref": "common/definitions-v1.json#/$defs/uuidv7" },
            "uniqueItems": true
          }
        }
      }
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "reason"],
        "properties": {
          "source_id": { "$ref": "common/definitions-v1.json#/$defs/uuidv7" },
          "reason": { "enum": ["budget", "stale", "refuted", "superseded", "archived", "low_priority", "missing_source", "policy_denied"] }
        }
      }
    },
    "assembly_trace": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "manifest_digest": { "$ref": "common/definitions-v1.json#/$defs/sha256" }
  }
}
