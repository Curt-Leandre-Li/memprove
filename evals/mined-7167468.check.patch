+    /// `memprove <words>` in `cwd` as `init_in` runs it (U22).
+    fn run_in(&self, cwd: &Path, words: &[&str]) -> Output {
+        let output = isolated(cli_binary())
+            .current_dir(cwd)
+            .env("HOME", &self.home)
+            .env("PATH", "/usr/bin:/bin")
+            .args(words)
+            .output()
+            .unwrap();
+        println!(
+            "$ memprove {}\n{}{}[exit {:?}]",
+            words.join(" "),
+            text(&output.stdout),
+            text(&output.stderr),
+            output.status.code()
+        );
+        output
+    }
