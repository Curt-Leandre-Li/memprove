+/// U22 (found by the first CI runs, whose machines upgrade twice within
+/// one second): an upgrade whose backup directory name
+/// (`<UTC second>-<build>`) is taken uses a free one, and the backups that
+/// were there stay as they were.
+#[test]
+fn u22_an_upgrade_in_a_second_whose_backup_name_is_taken_picks_a_free_one() {
+    let setup = Install::new();
+    assert_eq!(setup.install_from(&binaries()).status.code(), Some(0));
+    let build = build_of(&cli_binary());
+    let now = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .unwrap()
+        .as_secs();
+    let backups = setup.prefix.join("backups");
+    fs::create_dir_all(&backups).unwrap();
+    let taken: Vec<PathBuf> = (0..30)
+        .map(|offset| backups.join(format!("{}-{build}", utc_stamp(now + offset))))
+        .collect();
+    for dir in &taken {
+        fs::create_dir(dir).unwrap();
+        fs::write(dir.join("kept"), "an earlier backup\n").unwrap();
+    }
+
+    let upgraded = setup.install_from(&binaries());
+    assert_eq!(
+        upgraded.status.code(),
+        Some(0),
+        "{}",
+        text(&upgraded.stderr)
+    );
+    for dir in &taken {
+        let names: Vec<_> = fs::read_dir(dir)
+            .unwrap()
+            .map(|e| e.unwrap().file_name())
+            .collect();
+        assert_eq!(names, ["kept"], "{} was written into", dir.display());
+    }
+    let written: Vec<PathBuf> = fs::read_dir(&backups)
+        .unwrap()
+        .map(|entry| entry.unwrap().path())
+        .filter(|path| !taken.contains(path))
+        .collect();
+    assert_eq!(written.len(), 1, "{written:?}");
+    assert!(written[0].join("SHA256SUMS").is_file());
+    assert!(
+        text(&upgraded.stdout).contains(&format!("Backup: {}.", written[0].display())),
+        "{}",
+        text(&upgraded.stdout)
+    );
+}
